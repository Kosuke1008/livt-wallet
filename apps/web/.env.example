# Trusted LivT backend origin. Use HTTPS outside local development.
VITE_LIVT_API_BASE_URL=https://livt.example
VITE_BLOCKCHAIN_NETWORK=kairos
VITE_BLOCKCHAIN_KAIROS_RPC_URL=https://public-en-kairos.node.kaia.io
# Profile validation/read-only preparation only. Mainnet payment execution is
# hard-disabled in Phase 1 even if VITE_MAINNET_PAYMENTS_ENABLED=true.
VITE_BLOCKCHAIN_KAIA_MAINNET_RPC_URL=
VITE_MAINNET_PAYMENTS_ENABLED=false
# Legacy Kairos RPC name remains accepted during migration:
# VITE_KAIROS_RPC_URL=
